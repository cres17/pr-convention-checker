{
  "description": "Workflow secret change without ops docs should fail",
  "category": "ci",
  "risk": "high",
  "expected_reason": "A deployment secret contract changed without ops documentation.",
  "source": "synthetic-fixture",
  "changed_files": [
    {
      "path": ".github/workflows/deploy.yml",
      "status": "modified",
      "previous_path": null,
      "patch": "diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml\n@@ -1 +1 @@\n+      DEPLOY_TOKEN: ${{ secrets.PROD_DEPLOY_TOKEN }}\n"
    }
  ],
  "drift_ignores": [],
  "policy": {
    "rules": [
      {
        "id": "workflow-secret-sync",
        "when": {
          "any_changed": [".github/workflows/**"],
          "min_change_intensity": "ci-secret-change"
        },
        "require": {
          "groups": [
            {"name": "Ops docs", "any_changed": ["docs/ops/**", "docs/runbook/**"]}
          ]
        },
        "severity": "major",
        "message": "Workflow secret changed without ops docs"
      }
    ],
    "gate": {"fail_on_blocker": true, "fail_on_major_count": 1},
    "ignore_paths": []
  },
  "expected": {
    "result": "fail",
    "blocker_count": 0,
    "major_count": 1,
    "violation_rule_ids": ["workflow-secret-sync"]
  }
}
