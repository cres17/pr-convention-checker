        "rules": [
          {
            "id": "contract",
            "severity": "blocker",
            "when": {
              "any_changed": [
                "src/**"
              ],
              "min_change_intensity": "route-contract-change"
            },
            "require": {
              "groups": [
                {
                  "name": "docs",
                  "all_changed": [
