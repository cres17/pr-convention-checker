{
  "protocol": {
    "version": 2,
    "input": "real Git before/after snapshots and bounded current documents",
    "axes": [
      "facts",
      "decision",
      "verification",
      "gate"
    ],
    "authorship": "author-created, non-blind; regression controls, not real PR accuracy",
    "freeze": "expected values written before first harness run; suite v1 remains unchanged"
  },
  "cases": [
    {
      "id": "multiline-current",
      "before": {
        "src/api.py": "from fastapi import FastAPI\napp = FastAPI()\n@app.get(\n    '/old'\n)\ndef read():\n    return {}\n",
        "docs/api.md": "| GET | /new |\n"
      },
      "after": {
        "src/api.py": "from fastapi import FastAPI\napp = FastAPI()\n@app.get(\n    '/new'\n)\ndef read():\n    return {}\n"
      },
      "policy": {
        "rules": [
          {
            "id": "contract",
            "severity": "blocker",
            "when": {
              "any_changed": [
                "src/**"
              ],
              "min_change_intensity": "route-contract-change"
            },
            "require": {
              "groups": [
                {
                  "name": "document",
                  "all_changed": [
                    "docs/api.md"
                  ],
                  "content": "auto-strict"
                }
              ]
            }
          }
        ],
        "gate": {
          "on_unverified": "warn"
        }
      },
      "facts_kind": "routes",
      "expected": {
        "facts": {
          "added": [
            "GET /new"
          ],
          "removed": [
            "GET /old"
          ]
        },
        "decision": "satisfied",
        "verification": "verified",
        "gate": "pass"
      }
    },
