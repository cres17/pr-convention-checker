{
  "version": "generalization-audit-v1",
  "protocol": "Post-development adversarial audit. Cases and expected results written before first execution; code is frozen during this audit. Author has seen the implementation, so this is not blind or independent third-party validation. Supported and explicitly unsupported boundary cases are reported separately. Synthetic engine-level inputs; no production accuracy claim.",
  "policies": {
    "api": {
      "rules": [
        {
          "id": "api-doc",
          "when": {
            "any_changed": [
              "src/routes/**"
            ],
            "min_change_intensity": "route-contract-change"
          },
          "require": {
            "groups": [
              {
                "name": "API docs",
                "any_changed": [
                  "docs/api/**",
                  "openapi/**"
                ]
              }
            ]
          },
          "severity": "blocker"
        }
      ]
    },
    "env": {
      "rules": [
        {
          "id": "env-sync",
          "when": {
            "any_changed": [
              "src/config/**"
            ],
            "min_change_intensity": "config-key-added"
          },
          "require": {
            "groups": [
              {
                "name": "sample",
                "all_changed": [
                  ".env.example"
                ],
                "content": "env-keys"
              }
            ]
          },
          "severity": "blocker"
        }
      ]
    }
  },
  "cases": [
    {
      "id": "A01-get-added",
      "scope": "supported",
      "policy": "api",
      "expected": "fail",
      "reason": "A new literal GET endpoint needs docs.",
      "changed_files": [
        {
          "path": "src/routes/catalog.py",
          "status": "modified",
          "patch": "+@app.get('/catalog')\n"
        }
      ]
    },
    {
      "id": "A02-delete-added",
      "scope": "supported",
      "policy": "api",
      "expected": "fail",
