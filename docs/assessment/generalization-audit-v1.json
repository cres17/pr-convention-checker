        {
          "path": "docs/api/catalog.md",
          "status": "modified",
          "patch": "-GET /catalog\n+GET /products\n"
        }
      ]
    },
    {
      "id": "A06-unrelated-route-doc",
      "scope": "supported",
      "policy": "api",
      "expected": "fail",
      "reason": "An unrelated endpoint update does not document this change.",
      "changed_files": [
        {
          "path": "src/routes/catalog.py",
          "status": "modified",
          "patch": "-@app.get('/catalog')\n+@app.get('/products')\n"
